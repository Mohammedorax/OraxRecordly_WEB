# Caching and safety headers for hosts that honour a `_headers` file
# (Cloudflare Pages, Netlify). GitHub Pages ignores this file, which is why the
# service worker in /sw.js exists as well - between the two, returning visitors
# stop revalidating everything whether the site is served from Pages or from a CDN.
#
# The only truly immutable URLs are the content-hashed build outputs; images and
# fonts are stable but not hashed, so they get a week rather than a year.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cache-Control: public, max-age=0, must-revalidate

/*.avif
  Cache-Control: public, max-age=604800
/*.webp
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
/*.woff2
  Cache-Control: public, max-age=604800

/sw.js
  Cache-Control: no-cache
